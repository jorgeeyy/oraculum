# Copy this file to .env and replace the placeholder values with your own.
# Never commit the real .env file.

OPENAI_API_KEY=replace_me
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_assistant

# Ingestion tuning (optional; defaults shown)
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
MAX_FILE_SIZE_BYTES=10485760
UPLOADS_DIR=data/uploads

# Embeddings and vector store (optional; defaults shown)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
CHROMA_DIR=data/chroma

# Chat generation (optional; defaults shown)
CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=500
CHAT_TEMPERATURE=0.0

# Reliability and security (optional; defaults shown)
RATE_LIMIT_PER_MINUTE=60
# API_KEY=change_me_to_a_long_random_string
