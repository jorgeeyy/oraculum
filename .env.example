# Copy this file to .env and replace the placeholder values with your own.
# Never commit the real .env file.

OPENAI_API_KEY=replace_me
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_assistant

# Ingestion tuning (optional; defaults shown)
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
MAX_FILE_SIZE_BYTES=10485760
UPLOADS_DIR=data/uploads

# Embeddings and vector store (optional; defaults shown)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
CHROMA_DIR=data/chroma

# Retrieval (optional; defaults shown)
# 8: with 5, an answer's chunk could sit at rank 6 outside the cutoff.
RETRIEVAL_TOP_K=8
# Hybrid search: BM25 (SQLite FTS5) + vector ranks fused with Reciprocal
# Rank Fusion. Set to false to restore the legacy pure-vector path.
RETRIEVAL_HYBRID=true
RETRIEVAL_RRF_K=60
BM25_DB_PATH=data/bm25.db
# One-time backfill after enabling hybrid on an existing index:
#   uv run python scripts/backfill_bm25.py

# Chat generation (optional; defaults shown)
CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=500
CHAT_TEMPERATURE=0.0

# Reliability and security (optional; defaults shown)
RATE_LIMIT_PER_MINUTE=10
# API_KEY=change_me_to_a_long_random_string

# Logging (optional; defaults shown) — rotating file, 5 MB x 4. Set empty to disable.
LOG_FILE=data/logs/oraculum.log
